# NASA FIRMS API key — https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Neon Postgres connection string (pooled, from the Neon dashboard)
DATABASE_URL=

# Required by Nominatim's usage policy — identify your app, e.g. "focos-stibios/1.0 (contact@example.com)"
NOMINATIM_USER_AGENT=

# Shared secret for /api/cron/ingest. Vercel Cron sends it automatically as
# "Authorization: Bearer $CRON_SECRET" when this env var is set on the project.
CRON_SECRET=
