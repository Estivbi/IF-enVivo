# NASA FIRMS API key — https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Neon Postgres connection string (pooled, from the Neon dashboard)
DATABASE_URL=

# Required by Nominatim's usage policy — identify your app, e.g. "focos-stibios/1.0 (contact@example.com)"
NOMINATIM_USER_AGENT=

# Shared secret for /api/cron/ingest — also used by the GitHub Actions
# cron workflow (must match the CRON_SECRET repo secret).
CRON_SECRET=

# Optional. FRP (MW) threshold for heuristic level 2 ("growing"). Provisional
# value (50) used if unset — no official calibration exists yet, tune from
# real ingest data without a redeploy. See src/lib/matching.ts.
LEVEL2_FRP_THRESHOLD_MW=
